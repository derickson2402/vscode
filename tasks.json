{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build submission tarball",
      "type": "shell",
      "command": "util/submit.sh",
      "args": ["."]
    },
    {
      "label": "wReceiver post-debug clean",
      "type": "shell",
      "command": "rm -rf output/ && mkdir output && echo -n '' > wReceiver.log"
    },
    {
      "label": "wReceiver pre-launch clean and build",
      "dependsOn": ["wReceiver post-debug clean", "CMake: build"]
    },
    {
      "label": "wSender post-debug clean",
      "type": "shell",
      "command": "echo -n '' > wSender.log"
    },
    {
      "label": "wSender pre-launch clean and build",
      "dependsOn": ["wSender post-debug clean", "CMake: build"]
    }
