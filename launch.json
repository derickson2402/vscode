  "version": "0.2.0",
  "configurations": [
    {
      "name": "exampleProgramAAA",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/bin/exampleProgramAAA",
      "args": [
        "--port",
        "1111",
        "--output-log",
        "output.log"
      ]
    },
    {
      "name": "exampleProgramBBB",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/bin/exampleProgramBBB",
      "args": [
        "--port",
        "1111",
        "--output-log",
        "output.log"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Both",
      "configurations": [
        "exampleProgramAAA",
        "exampleProgramBBB"
      ]
    }
  ]
}
